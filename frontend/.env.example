# Copie este arquivo para ".env.local" e ajuste o endereço da API em C#.
# A URL já inclui o /api: os services usam só o resto do caminho (ex.: /propostas).
# Na máquina, a API roda em http://localhost:5153 (perfil http do launchSettings.json).
# Publicado: https://<nome-da-api>.azurewebsites.net/api
VITE_API_URL=http://localhost:5153/api
